<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Prism.Soundboard.App</StartupObject>
    <Authors>Thomas Castonguay-Gagnon</Authors>
    <Copyright>Thomas Castonguay-Gagnon</Copyright>
    <PackageLicenseExpression>GPL V3</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/the-prism/Soundboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/the-prism/Soundboard</RepositoryUrl>
    <AssemblyVersion>1.4.2.1</AssemblyVersion>
    <FileVersion>1.4.2.1</FileVersion>
    <Version>1.4.2</Version>
    <NoWarn>$(NoWarn);1573;1591;1712;SA0001</NoWarn>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzer config only; keep it out of build/publish output (it otherwise collides
         with the RCL's stylecop.json at the publish root). -->
    <Content Remove="stylecop.json" />
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Ships _framework/blazor.web.js. Version tracks the ASP.NET Core runtime. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.6" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WPF-UI" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Soundboard.Web\Prism.Soundboard.Web.csproj" />
  </ItemGroup>

  <!--
    The Microsoft.AspNetCore.App.Internal.Assets package registers _framework/blazor.web.js as a
    static web asset only for 'Exe' output under the Web SDK. This host is a WinExe WPF app on the
    Razor SDK, so that target is skipped. Register the file ourselves so MapStaticAssets serves it.
  -->
  <Target Name="_AddHostBlazorFrameworkStaticWebAssets"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration">
    <ItemGroup>
      <_HostFrameworkAssetCandidate Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js">
        <RelativePath>_framework/blazor.web.js</RelativePath>
      </_HostFrameworkAssetCandidate>
    </ItemGroup>

    <DefineStaticWebAssets
      CandidateAssets="@(_HostFrameworkAssetCandidate)"
      ContentRoot="$(BlazorFrameworkStaticWebAssetRoot)"
      SourceId="$(AssemblyName)"
      SourceType="Discovered"
      AssetKind="All"
      AssetMode="CurrentProject"
      AssetRole="Primary"
      FingerprintCandidates="true"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_HostFrameworkAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_HostFrameworkAsset)"
      ExistingEndpoints=""
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_HostFrameworkAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_HostFrameworkAsset)" />
      <StaticWebAssetEndpoint Include="@(_HostFrameworkAssetEndpoint)" />
    </ItemGroup>
  </Target>

</Project>
